# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Karam Pay (server-side only; never prefix with VITE_)
KARAM_PAY_API_URL="https://karam-pay-api.karam-pay.workers.dev"
# Set true only after a safe provider test is approved.
KARAM_PAY_ENABLED=false
# Keep provider credentials and webhook signing material here only when Karam Pay documents them.
KARAM_PAY_API_KEY=
KARAM_PAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# Supabase (PostgreSQL Database + Auth)
# Public keys safe for client bundle:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side service role key (NEVER prefix with VITE_):
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Cloudflare R2 / Images CDN (Server-side only — NEVER prefix with VITE_)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=souq-gaza-media
CLOUDFLARE_R2_PUBLIC_URL=
